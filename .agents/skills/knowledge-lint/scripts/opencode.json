{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "snapshot": false,
  "autoupdate": false,
  "provider": {
    "content-review": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Content Review",
      "options": {
        "baseURL": "{env:BASE_URL}",
        "apiKey": "{env:AUTH_TOKEN}",
        "headers": {
          "x-api-vkey": "{env:CANNBOT_VKEY}"
        }
      },
      "models": {
        "content-check": {
          "id": "{env:CONTENT_CHECK_MODEL_ID}",
          "name": "Content Check",
          "reasoning": true,
          "tool_call": true,
          "variants": {
            "low": {
              "reasoningEffort": "low"
            }
          }
        }
      }
    }
  },
  "permission": {
    "*": "deny",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "webfetch": "deny"
  }
}
