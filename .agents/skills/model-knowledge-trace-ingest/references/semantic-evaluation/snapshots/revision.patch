+            limitations.append('unrecognized_tool_status')
+            event['event_type'] = 'unknown'
+    if outcome:
+        event['outcome'] = outcome
+    if limitations:
+        event['limitations'] = sorted(set(limitations))
+        if any(item.startswith('ambiguous_') for item in limitations):
